{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "web-starter-v2",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "038e83e4-88fb-40cf-b573-c699339d387d",
      "database_name": "bemoat-web-starter-v2",
      "remote": true,
    },
  ],
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "bemoat-web-starter-v2","preview_bucket_name": "web-starter-v2-preview",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Local dev and tests use this named environment with remoteBindings disabled
  // in src/payload.config.ts. Remote dev deploys remain blocked until the D1
  // placeholder is replaced by a separately provisioned resource.
  "env": {
    "dev": {
      "name": "web-starter-v2-dev",
      "services": [],
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "DEV_DATABASE_ID",
          "database_name": "web-starter-v2-dev",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "web-starter-v2-dev",
          "preview_bucket_name": "web-starter-v2-dev-preview",
        },
      ],
    },
  },
}
